DISCORD_TOKEN=your_discord_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Optional: SQLite database path. Default is /data/bot.sqlite3.
# Leave unset in Docker, set it when running outside a container.
# DATABASE_PATH=./data/bot.sqlite3

# Old single-server settings, imported into the database on first start.
GUILD_ID=your_discord_guild_id
NOTIF_CHANNEL_ID=twitch_notification_channel_id
SOCIALS_CHANNEL_ID=socials/links_channel_id
TWITCH_USERNAMES_FILE=twitch_usernames.json
